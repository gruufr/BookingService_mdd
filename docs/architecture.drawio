<mxfile host="app.diagrams.net" agent="c4gen"><diagram id="p0" name="1. Context"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1300" pageHeight="760"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="cap0" value="C4 · Уровень 1 — Контекст системы" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="-30" width="700" height="30" as="geometry"/></mxCell><mxCell id="guest0" value="&lt;b&gt;Гость&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Человек]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Ищет отель, бронирует номер, смотрит и отменяет свои брони" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#08427b;strokeColor=#08427b;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="230" height="150" as="geometry"/></mxCell><mxCell id="admin0" value="&lt;b&gt;Разработчик / проверяющий&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Человек]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Проверяет API через curl или Postman" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#08427b;strokeColor=#08427b;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="380" width="230" height="150" as="geometry"/></mxCell><mxCell id="sys0" value="&lt;b&gt;Ночлег&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Программная система]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Сервис бронирования отелей: каталог, брони, гости, уведомления" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1168bd;strokeColor=#1168bd;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="230" width="300" height="190" as="geometry"/></mxCell><mxCell id="mail0" value="&lt;b&gt;Почтовый сервис&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Внешняя система, план]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Сейчас уведомления только сохраняются в журнал" style="rounded=1;arcSize=6;whit